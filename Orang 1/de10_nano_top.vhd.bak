library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity de10_nano_top is
    Port (
        FPGA_CLK1_50 : in  STD_LOGIC;                     -- Main 50 MHz Oscillator Pin
        KEY          : in  STD_LOGIC_VECTOR(1 downto 0); -- KEY(0)=Reset (Active-Low)
        SW           : in  STD_LOGIC_VECTOR(9 downto 0); -- SW(7..0)=Data, SW(8)=Error, SW(9)=Replay
        LEDR         : out STD_LOGIC_VECTOR(9 downto 0)  -- Hardware LEDs
    );
end entity de10_nano_top;

architecture Structural of de10_nano_top is
    signal reset_sys : STD_LOGIC;
begin
    reset_sys <= not KEY(0);

    u_top_level : entity work.top_level
        port map (
            clk_send      => FPGA_CLK1_50,
            clk_recv      => FPGA_CLK1_50,
            reset         => reset_sys,
            data_in       => x"00" & SW(7 downto 0),
            valid_in      => '1',
            inject_error  => SW(8),
            inject_replay => SW(9),
            data_out      => open,
            valid_out     => LEDR(0),
            crc_error     => LEDR(1),
            replay_err    => LEDR(2),
            fifo_full     => LEDR(3),
            fifo_empty    => LEDR(4)
        );

    LEDR(9 downto 5) <= (others => '0');
end architecture Structural;